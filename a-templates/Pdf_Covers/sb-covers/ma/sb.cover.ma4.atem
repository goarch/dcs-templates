Template sb.cover.ma4

Status Final

	import da.*
	import oc.*
	import me.*
	import eo.*
	import tr.*
	import pe.*

	import actors_gr_GR_cog.*
	import miscellanea_gr_GR_cog.*
	import prayers_gr_GR_cog.*
	import rubrical_gr_GR_cog.*
	import template.titles_gr_GR_cog.*
	import titles_gr_GR_cog.*

	import iTags.*
	import bTags.*
	import roles.*
	import rules.*

Section content
	Para role sb_pdf_cover_begin sid misc.custcontent End-Para

		Title role sb_cover81 sid pdf.covers_gr_GR_cog.cover_attribution1.text End-Title
		Title role sb_cover82 sid pdf.covers_gr_GR_cog.cover_attribution2.text End-Title

		when-date-is
			Jan 1 use:
				Section title_me
					Title role sb_cover1 sid ma.pdf.cover End-Title
					Title role sb_cover3 sid d.for ldp @Service_Date End-Title
				End-Section
			Jul 22 use:
				Section jul22
					Insert_section title_me End-Insert
					Section mode_eothinon
						when-name-of-day-is
							Sunday use:
								Title role sb_cover5 sid misc.book.Octoechos.name sid d.delimiter rid ocBK.ModeNaked End-Title
								Insert_section sb.cover.lookup.on_morning End-Insert
								Title role sb_cover4 sid ti.Eothinon ldp @Eothinon End-Title
						end-when
					End-Section
					Section commeoration
						Title role sb_cover5 sid misc.book.Menaion.name sid d.delimiter sid me.m07.d22_gr_GR_cog.meDA.date End-Title
						Title role sb_cover4 sid me.m07.d22_gr_GR_cog.meDA.commemoration.first_short End-Title
						Title role sb_cover5 sid misc.book.MeSupplement.name End-Title
						Title role sb_cover4 sid me.m07.d22_gr_GR_cog.alt1.meDA.commemoration.first_short End-Title
					End-Section
					Section katavasia
						Insert_section KA._title End-Insert
					End-Section
				End-Section
			Sep 17 use:
				Section sep17
					Insert_section title_me End-Insert
					Section mode_eothinon
						when-name-of-day-is
							Sunday use:
								Title role sb_cover5 sid misc.book.Octoechos.name sid d.delimiter rid ocBK.ModeNaked End-Title
								Insert_section sb.cover.lookup.on_morning End-Insert
								Title role sb_cover4 sid ti.Eothinon ldp @Eothinon End-Title
						end-when
					End-Section
					Section commeoration
						Title role sb_cover5 sid misc.book.Menaion.name sid d.delimiter sid me.m09.d17_gr_GR_cog.meDA.date End-Title
						Title role sb_cover5 sid misc.book.MeSupplement.name End-Title
						Title role sb_cover4 sid me.m09.d17_gr_GR_cog.meDA.commemoration.first_short End-Title
					End-Section
					Section katavasia
						Insert_section KA._title End-Insert
					End-Section
				End-Section
			Oct 20 use:
				Section oct20
					Insert_section title_me End-Insert
					Section mode_eothinon
						when-name-of-day-is
							Sunday use:
								Title role sb_cover5 sid misc.book.Octoechos.name sid d.delimiter rid ocBK.ModeNaked End-Title
								Insert_section sb.cover.lookup.on_morning End-Insert
								Title role sb_cover4 sid ti.Eothinon ldp @Eothinon End-Title
						end-when
					End-Section
					Section commeoration
						Title role sb_cover5 sid misc.book.Menaion.name sid d.delimiter sid me.m10.d20_gr_GR_cog.meDA.date End-Title
						Title role sb_cover4 sid me.m10.d20_gr_GR_cog.meDA.commemoration.first_short End-Title
						Title role sb_cover5 sid misc.book.MeSupplement.name End-Title
						Title role sb_cover4 sid me.m10.d20_gr_GR_cog.alt1.meDA.commemoration.first_short End-Title
					End-Section
					Section katavasia
						Insert_section KA._title End-Insert
					End-Section
				End-Section
			Nov 14 use:
				Section nov14
					Insert_section title_me End-Insert
					Section mode_eothinon
						when-name-of-day-is
							Sunday use:
								Title role sb_cover5 sid misc.book.Octoechos.name sid d.delimiter rid ocBK.ModeNaked End-Title
								Insert_section sb.cover.lookup.on_morning End-Insert
								Title role sb_cover4 sid ti.Eothinon ldp @Eothinon End-Title
						end-when
					End-Section
					Section commeoration
						Title role sb_cover5 sid misc.book.Menaion.name sid d.delimiter sid me.m11.d14_gr_GR_cog.meDA.date End-Title
						Title role sb_cover4 sid me.m11.d14_gr_GR_cog.meDA.commemoration.first_short End-Title
						Title role sb_cover5 sid misc.book.MeSupplement.name End-Title
						Title role sb_cover4 sid me.m11.d14_gr_GR_cog.alt1.meDA.commemoration.first_short End-Title
					End-Section
					Section katavasia
						Insert_section KA._title End-Insert
					End-Section
				End-Section
		end-when

		// Title role sb_cover6 sid pref.generation_alwb.cover.version End-Title

	Para role sb_pdf_cover_end sid misc.custcontent End-Para
End-Section

End-Template
