Template bk.consecration.f01.ve9 

Status Review

//F01
//When the church is named for a feast of the Lord or the Mother of God
//When the consecration is conducted on a weekday without a celebrated saint

	import da.*
	import oc.*
	import me.*
	import eo.*
	import tr.*
	import pe.*

	import actors_gr_GR_cog.*
	import dismissals_gr_GR_cog.*
	import miscellanea_gr_GR_cog.*
	import prayers_gr_GR_cog.*
	import rubrical_gr_GR_cog.*
	import titles_gr_GR_cog.*

	import iTags.*
	import bTags.*
	import roles.*

	Head
		//The full date of the consecration needs to be set here
		Set_Date month 0 day 0 year 0000 End_Date
	End_Head

	Section Instance_f01
		Insert_section CONS.Service_Title__.Vespers End-Insert
		//The hierarch's name for petitions is set by the client
		Insert_section VE._01_Beginning__.vespers End-Insert
		//Ctrl+spacebar on the CHURCH_NAME to select the name of the church being consecrated
		Insert_section CONS.DateSetting__.CHURCH_NAME End-Insert
		Insert_section CONS.VE_02_LordIHaveCried_Mode__.for8 End-Insert
		//The title can be generic or specific set by the client
		Insert_section TI.local_church End-Insert
		Insert_section CONS.VE_03_Stichera__.church__.as_3456 End-Insert
		Insert_section CONS.VE_03_Stichera__.i_1234as78910 End-Insert
		//The title can be generic or specific set by the client
		Insert_section TI.g.local_church End-Insert
		Insert_section VE._03_Stichera__.glory__.me__.gloryasglory_.hymn End-Insert //add glory from mc
		Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
		//The following hymn gets church's name set by client
		Insert_section CONS.VE_03_Stichera__.both__.consecration_with_clientname_ End-Insert
		Insert_section VE._04_Middle__.hierarchical__.entrance End-Insert
		Insert_section CONS.VE_05_Readings__.r123 End-Insert
		Insert_section VE._06_Litanies__.fullektenia End-Insert
		Insert_section CONS.VE_08_Aposticha__.i_consecration12 End-Insert
		//Ctrl+spacebar on the CHURCH_NAME to select the name of the church being consecrated
		Insert_section CONS.DateSetting__.CHURCH_NAME End-Insert
		//The title can be generic or specific set by the client
		Insert_section TI.g.local_church End-Insert
		Insert_section VE._08_Aposticha__.glory__.me__.gloryasglory_.hymn End-Insert
		Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
		Insert_section CONS.VE_08_Aposticha__.both End-Insert
		Insert_section VE._09_Symeon_Trisagion__.hierarchical End-Insert
		Insert_section AP.con End-Insert
		//The Apolytikion of the church is set by the client
		Insert_section TI.g.local_church End-Insert
		Insert_section AP.client1_.hymn End-Insert
		Insert_section AP.both__.con End-Insert
		Insert_section VE._10_End__.hierarchical__.wisdom123.part1 End-Insert
		Insert_section VE._11_Dismissal__.hierarchical__.nocommemoration End-Insert
	End-Section

End-Template