Template bk.consecration.s10.ve9

Status Review

//S10
//When the church is named for a saint
//When the consecration is conducted on a post-festal weekday without a celebrated saint

	import da.*
	import oc.*
	import me.*
	import eo.*
	import tr.*
	import pe.*

	import actors_gr_GR_cog.*
	import dismissals_gr_GR_cog.*
	import miscellanea_gr_GR_cog.*
	import prayers_gr_GR_cog.*
	import rubrical_gr_GR_cog.*
	import titles_gr_GR_cog.*

	import iTags.*
	import bTags.*
	import roles.*

	Head
		//The full date of the consecration needs to be set here
		Set_Date month 0 day 0 year 0000 End_Date
	End_Head

	Section Instance_s10
		Insert_section CONS.Service_Title__.Vespers End-Insert
		//The hierarch's name for petitions is set by the client
		Insert_section VE._01_Beginning__.hierarchical__.vespers End-Insert
		Insert_section CONS.DateSetting__.Principal_Feast_of_Period End-Insert
		Insert_section CONS.VE_02_LordIHaveCried_Mode__.for10 End-Insert
		Insert_section TI.stp.f End-Insert
		Insert_section CONS.VE_03_Stichera__.festal_123as123 End-Insert
		Insert_section CONS.VE_03_Stichera__.i_1234as4567 End-Insert
		//Ctrl+spacebar on the CHURCH_NAME to select the name of the church being consecrated
		Insert_section CONS.DateSetting__.CHURCH_NAME End-Insert
		//The title can be generic or specific set by the client
		Insert_section TI.stp.local_church End-Insert
		Insert_section CONS.VE_03_Stichera__.church__.as_8910 End-Insert
		when-exists
			rid meVE.SticGlory.text use:
				Insert_section VE._03_Stichera__.glory__.me__.gloryasglory_ End-Insert
				Insert_section CONS.VE_03_Stichera__.both__.consecration_with_clientname_ End-Insert
			otherwise use:
				Insert_section TI.g.con End-Insert
				Insert_section CONS.VE_03_Stichera__.gloryboth__.consecration_with_clientname_.hymn End-Insert
				Insert_section CONS.DateSetting__.Principal_Feast_of_Period End-Insert
				Insert_section TI.b.f End-Insert
				when-movable-cycle-day-is
					95, 110, 120 use:
						Insert_section VE._03_Stichera__.glory__.pe__.gloryasglory_.hymn End-Insert
					otherwise use:
						Insert_section VE._03_Stichera__.glory__.me__.gloryasglory_.hymn End-Insert
				end-when
		end-when
		Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
		Insert_section VE._04_Middle__.hierarchical__.entrance End-Insert
		Insert_section CONS.VE_05_Readings__.r123 End-Insert
		Insert_section VE._06_Litanies__.fullektenia End-Insert //selection for monastery?
		Insert_section CONS.VE_08_Aposticha__.i_consecration12 End-Insert
		//Ctrl+spacebar on the CHURCH_NAME to select the name of the church being consecrated
		Insert_section CONS.DateSetting__.CHURCH_NAME End-Insert
		when-exists
			rid meVE.AposGlory.text use:
				//The title can be generic or specific set by the client
				Insert_section TI.g.local_church End-Insert
				Insert_section VE._08_Aposticha__.glory__.me__.gloryasglory_.hymn End-Insert
				Insert_section CONS.DateSetting__.Principal_Feast_of_Period End-Insert
				Insert_section TI.b.f End-Insert
				Insert_section VE._08_Aposticha__.both__.me__.gloryasboth_.hymn End-Insert
			otherwise use:
				Insert_section CONS.VE_08_Aposticha__.glory End-Insert
				Insert_section CONS.DateSetting__.Principal_Feast_of_Period End-Insert
				Insert_section TI.b.f End-Insert
				Insert_section VE._08_Aposticha__.both__.me__.gloryasboth_.hymn End-Insert
		end-when
		Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
		Insert_section VE._09_Symeon_Trisagion__.hierarchical End-Insert
		//The Apolytikion of the church is set by the client
		Insert_section AP.client1_ End-Insert
		Insert_section AP.glory__.con End-Insert
		Insert_section AP.both__.af End-Insert
		Insert_section VE._10_End__.hierarchical__.wisdom123.part1 End-Insert
		Insert_section VE._11_Dismissal__.hierarchical__.nocommemoration End-Insert
	End-Section

End-Template