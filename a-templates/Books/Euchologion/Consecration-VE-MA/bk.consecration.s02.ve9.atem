Template bk.consecration.s02.ve9

Status Review

//S02
//When the church is named for a saint
//When the consecration is conducted on a Sunday without a celebrated saint

	import da.*
	import oc.*
	import me.*
	import eo.*
	import tr.*
	import pe.*

	import actors_gr_GR_cog.*
	import dismissals_gr_GR_cog.*
	import miscellanea_gr_GR_cog.*
	import prayers_gr_GR_cog.*
	import rubrical_gr_GR_cog.*
	import titles_gr_GR_cog.*

	import iTags.*
	import bTags.*
	import roles.*

	Head
		//The full date of the consecration needs to be set here
		Set_Date month 0 day 0 year 0000 End_Date
	End_Head

	Section Instance_s02
		Insert_section CONS.Service_Title__.Vespers End-Insert
		Insert_section VE._01_Beginning__.hierarchical__.vespers End-Insert
		Insert_section VE._02_LordIHaveCried__.hierarchical__.modeofweek__.for10 End-Insert
		Insert_section VE._03_Stichera__.oc__.sunday__.s_1234as1234 End-Insert
		Insert_section CONS.VE_03_Stichera__.i_123as567 End-Insert
		//Ctrl+spacebar on the CHURCH_NAME to select the name of the church being consecrated
		Insert_section CONS.DateSetting__.CHURCH_NAME End-Insert
		Insert_section TI.stp.local_church End-Insert
		Insert_section CONS.VE_03_Stichera__.church__.as_8910 End-Insert
		when-exists
			rid meVE.SticGlory.text use:
				Insert_section VE._03_Stichera__.glory__.me__.gloryasglory_ End-Insert
				Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
				Insert_section VE._03_Stichera__.both__.firsttheotokion__.modeofweek End-Insert
			otherwise use:
				Insert_section CONS.VE_03_Stichera__.glory__.consecration_with_clientname_ End-Insert
				Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
				Insert_section VE._03_Stichera__.both__.firsttheotokion__.modeofweek End-Insert
		end-when
		Insert_section VE._04_Middle__.hierarchical__.entrance End-Insert
		Insert_section CONS.VE_05_Readings__.r123 End-Insert
		Insert_section VE._06_Litanies__.fullektenia End-Insert
		Insert_section VE._08_Aposticha__.oc__.sunday__.aposticha1234 End-Insert
		//Ctrl+spacebar on the CHURCH_NAME to select the name of the church being consecrated
		Insert_section CONS.DateSetting__.CHURCH_NAME End-Insert
		when-exists
			rid meVE.AposGlory.text use:
				Insert_section TI.g.local_church End-Insert
				Insert_section VE._08_Aposticha__.glory__.me__.gloryasglory_.hymn End-Insert
				Insert_section CONS.VE_08_Aposticha__.both End-Insert
			otherwise use:
				Insert_section CONS.VE_08_Aposticha__.gloryboth End-Insert
		end-when
		Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
		Insert_section VE._09_Symeon_Trisagion__.hierarchical End-Insert
		Insert_section AP.res__.modeofweek End-Insert
		Insert_section TI.g.local_church End-Insert
		Insert_section AP.client1_.hymn End-Insert
		Insert_section AP.both__.con End-Insert
		Insert_section VE._10_End__.hierarchical__.wisdom123.part1 End-Insert
		Insert_section VE._11_Dismissal__.hierarchical__.nocommemoration End-Insert
	End-Section

End-Template