Template sb.cover.ve.holyweek

Status NA //This template has been functionally replaced by pdf.cover.ve.mc

	import da.*
	import oc.*
	import me.*
	import eo.*
	import tr.*
	import pe.*

	import actors_gr_GR_cog.*
	import miscellanea_gr_GR_cog.*
	import prayers_gr_GR_cog.*
	import rubrical_gr_GR_cog.*
	import template.titles_gr_GR_cog.*
	import titles_gr_GR_cog.*

	import iTags.*
	import bTags.*
	import roles.*
	import rules.*


		Section title
			Para role sb_cover_logo_line_above sid pdf.covers_gr_GR_cog.cover_logo_line End-Para
			Para role sb_cover_logo1 sid pdf.covers_gr_GR_cog.cover_logo1.text End-Para
			Para role sb_cover_logo2 sid pdf.covers_gr_GR_cog.cover_logo2.text End-Para
			Para role sb_cover_logo_line_below sid pdf.covers_gr_GR_cog.cover_logo_line End-Para
			Title role sb_cover1 sid hw.pdf.cover sid misc.separator.endash ldp@Service_Year End-Title
			when-movable-cycle-day-is
				65 use:
					Insert_section sb.cover.lookup.mc_vespers_on_day_before End-Insert
				66 use:
					Title role sb_cover2 sid pl.pdf.cover sid d.onMondayMorning End-Title
					Title role sb_cover3 sid ve.pdf.header sid hw.ofholytuesday End-Title
				67 use:
					Title role sb_cover2 sid pl.pdf.cover sid d.onTuesdayMorning End-Title
					Title role sb_cover3 sid ve.pdf.header sid hw.ofholywednesday End-Title
				68 use:
					Title role sb_cover2 sid pl.pdf.cover sid d.onWednesdayMorning End-Title
					Title role sb_cover3 sid ve.pdf.header sid hw.ofholythursday End-Title
				69 use:
					Title role sb_cover2 sid vl.pdf.cover sid d.onThursdayMorning End-Title
					Title role sb_cover3 sid ve.pdf.header sid hw.ofholyfriday End-Title
				70 use:
					Title role sb_cover2 sid hw.removal sid d.onFridayAfternoon End-Title
					Title role sb_cover3 sid ve.pdf.header sid hw.ofholysaturday End-Title
				71 use:
					Title role sb_cover2 sid vl.pdf.cover sid d.onSaturdayMorning End-Title
					Title role sb_cover3 sid ve.pdf.header sid pa.ofpascha End-Title
			end-when
		End-Section

		// Title role sb_cover6 sid pref.generation_alwb.cover.version End-Title


End-Template
