					Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
					Insert_section MA._13_Lauds__.oc__.s_1234as1234 End-Insert
					Insert_section CONS.MA_13_Lauds__.feast__.as_5678 End-Insert
				Apr 24 use:
					Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
					Insert_section MA._13_Lauds__.oc__.s_1234as1234 End-Insert
					Insert_section CONS.MA_13_Lauds__.feast__.as_5678 End-Insert
