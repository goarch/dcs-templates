Template bk.consecration.f11.ma

Status Draft

//f11
//When the church is named for a feast of the Lord or the Mother of God
//When the consecration is conducted on a Sunday, during a festal period, on the date of a celebrated saint

	import da.*
	import oc.*
	import me.*
	import eo.*
	import tr.*
	import pe.*

	import actors_gr_GR_cog.*
	import dismissals_gr_GR_cog.*
	import miscellanea_gr_GR_cog.*
	import prayers_gr_GR_cog.*
	import rubrical_gr_GR_cog.*
	import titles_gr_GR_cog.*

	import iTags.*
	import bTags.*
	import roles.*

	Head
		//The full date of the consecration needs to be set here
		Set_Date month 0 day 0 year 0000 End_Date
	End_Head

	Section church_date
		//Ctrl+spacebar right after CHURCH_NAME to select the name of the church being consecrated
		Insert_section CONS.DateSetting__.CHURCH_NAME End-Insert
	End-Section
	
	Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
	Section Instance_f11
		Insert_section CONS.Service_Title__.Matins End-Insert
		Insert_section MA._01_Beginning__.modeofweek End-Insert
