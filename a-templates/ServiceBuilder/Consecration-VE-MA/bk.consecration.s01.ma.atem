Template bk.consecration.s01.ma 

Status Review

//s01
//When the church is named for a saint
//When the consecration is conducted on a weekday without a celebrated saint

	import da.*
	import oc.*
	import me.*
	import eo.*
	import tr.*
	import pe.*

	import actors_gr_GR_cog.*
	import dismissals_gr_GR_cog.*
	import miscellanea_gr_GR_cog.*
	import prayers_gr_GR_cog.*
	import rubrical_gr_GR_cog.*
	import titles_gr_GR_cog.*

	import iTags.*
	import bTags.*
	import roles.*

	Head
		Set_Date month 0 day 0 year 0000 End_Date
	End_Head

	Section church_date
		Insert_section CONS.DateSetting__.CHURCH_NAME End-Insert
	End-Section
	
	Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
	Section Instance_s01
		Insert_section CONS.Service_Title__.Matins End-Insert
		Insert_section MA._01_Beginning__.mode4 End-Insert
		Insert_section AP.consecration End-Insert
		Insert_section AP.glory__.client1 End-Insert
		Insert_section AP.both__.consecration End-Insert
		Insert_section MA._02_Kathisma1__.litany End-Insert
	Insert_section church_date End-Insert
		Insert_section CONS.MA_02_Kathisma1__.church_saint_and_consecration End-Insert
		Insert_section CONS.MA_03_Kathisma2__.church_saint_and_consecration End-Insert
		Insert_section CONS.MA_05_Kathisma3__.church_saint_and_consecration End-Insert
		Insert_section CONS.MA_06_07_08_Gospel__.church_saint End-Insert
	Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
		Insert_section MA._11_Kontakion__.consecration End-Insert
		Insert_section SY.Synaxarion End-Insert
		Insert_section hKA._1345678 End-Insert
		Insert_section MA._10_Canon__.ode9_intro__.hierarch End-Insert
		Insert_section MA._10_Canon__.magnificat__.modeofkatavasia End-Insert
		Insert_section hKA._9 End-Insert
		Insert_section MA._10_Canon__.litanies__.ode9 End-Insert
	Insert_section church_date End-Insert
		Insert_section CONS.MA_12_Exaposteilarion__.church_saint_and_consecration End-Insert
		Insert_section MA._13_Lauds__.hierarchical__.mode4 End-Insert
		Insert_section CONS.MA_prayers End-Insert
		Insert_section CONS.MA_13_Lauds__.consecration_and_church_saint End-Insert
		Insert_section CONS.MA_13_Lauds__.glory_and_both__.church_saint_and_consecration End-Insert
	Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
		Insert_section MA._14_Doxology__.great End-Insert
		Insert_section AP.consecration End-Insert
		Section End
			Insert_section LN.FervLitany_short_deacon_choir End-Insert
			Insert_section LN.CompLitanyMA_deacon_choir End-Insert
			Insert_section LN.hBowHeadsMA_deacon_choir End-Insert
			Insert_section MA._18_End__.hierarchical__.wisdom123.part1 End-Insert
			Insert_section MA._18_End__.hierarchical__.wisdom123.part2 End-Insert
			Insert_section MA._18_End__.hierarchical__.wisdom123.part3 End-Insert
		End-Section
		Insert_section MA._20_Dismissal__.hierarchical__.nocommemoration End-Insert
	End-Section

End-Template