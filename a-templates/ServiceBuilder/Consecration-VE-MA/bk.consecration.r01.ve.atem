Template bk.consecration.r01.ve 

Status Review

//r01
//When the church is named for the Resurrection
//When the consecration is conducted on a weekday or Sunday, without a celebrated saint

	import da.*
	import oc.*
	import me.*
	import eo.*
	import tr.*
	import pe.*

	import actors_gr_GR_cog.*
	import dismissals_gr_GR_cog.*
	import miscellanea_gr_GR_cog.*
	import prayers_gr_GR_cog.*
	import rubrical_gr_GR_cog.*
	import titles_gr_GR_cog.*

	import iTags.*
	import bTags.*
	import roles.*

	Head
		Set_Date month 0 day 0 year 0000 End_Date
	End_Head

	when-name-of-day-is
		Sunday use:
			Section Instance_r01_Sunday
				Insert_section CONS.Service_Title__.Vespers End-Insert
				Insert_section VE._01_Beginning__.hierarchical__.vespers End-Insert
				Insert_section VE._02_LordIHaveCried__.modeofweek__.for10 End-Insert
				Insert_section VE._03_Stichera__.oc__.sunday__.s_123456as123456 End-Insert
				Insert_section CONS.VE_03_Stichera__.consecration__.i_1234as78910 End-Insert
				Insert_section CONS.VE_03_Stichera__.glory__.consecration End-Insert
				Insert_section VE._03_Stichera__.both__.firsttheotokion__.modeofweek End-Insert
				Insert_section VE._04_Middle__.hierarchical__.entrance End-Insert
				Insert_section CONS.VE_05_Readings__.consecration123 End-Insert
				Insert_section VE._06_Litanies__.hierarchical__.fullektenia End-Insert
				Insert_section VE._08_Aposticha__.oc__.sunday__.aposticha1234 End-Insert
				Insert_section CONS.VE_08_Aposticha__.gloryboth__.consecration End-Insert
				Insert_section VE._09_Symeon_Trisagion__.hierarchical End-Insert
				Insert_section AP.res__.modeofweek End-Insert
				Insert_section AP.glory__.client1 End-Insert
				Insert_section AP.both__.consecration End-Insert
				Insert_section VE._10_End__.hierarchical__.wisdom123.part1 End-Insert
				Insert_section VE._11_Dismissal__.hierarchical__.nocommemoration End-Insert
			End-Section
		otherwise use:
			Section Instance_r01_Weekday
				Insert_section CONS.Service_Title__.Vespers End-Insert
				Insert_section VE._01_Beginning__.hierarchical__.vespers End-Insert
				Insert_section VE._02_LordIHaveCried__.mode6__.for6 End-Insert
				Insert_section CONS.VE_03_Stichera__.consecration__.i_123456as5678910 End-Insert
				Insert_section CONS.VE_03_Stichera__.gloryboth__.consecration_ End-Insert
				Insert_section VE._04_Middle__.hierarchical__.entrance End-Insert
				Insert_section CONS.VE_05_Readings__.consecration123 End-Insert
				Insert_section VE._06_Litanies__.hierarchical__.fullektenia End-Insert
				Insert_section CONS.VE_08_Aposticha__.consecration End-Insert
				Insert_section CONS.VE_08_Aposticha__.gloryboth__.consecration End-Insert
				Insert_section VE._09_Symeon_Trisagion__.hierarchical End-Insert
				Insert_section AP.client1 End-Insert
				Insert_section AP.glory__.consecration  End-Insert
				Insert_section AP.both__.client1 End-Insert
				Insert_section VE._10_End__.hierarchical__.wisdom123.part1 End-Insert
				Insert_section VE._11_Dismissal__.hierarchical__.nocommemoration End-Insert
			End-Section
	end-when

End-Template