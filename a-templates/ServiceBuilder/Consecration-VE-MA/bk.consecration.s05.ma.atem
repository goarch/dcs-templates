Template bk.consecration.s05.ma 

Status Review

//s05
//When the church is named for a saint
//When the consecration is conducted on a weekday, on the date of a celebrated saint

	import da.*
	import oc.*
	import me.*
	import eo.*
	import tr.*
	import pe.*

	import actors_gr_GR_cog.*
	import dismissals_gr_GR_cog.*
	import miscellanea_gr_GR_cog.*
	import prayers_gr_GR_cog.*
	import rubrical_gr_GR_cog.*
	import titles_gr_GR_cog.*

	import iTags.*
	import bTags.*
	import roles.*

	Head
		Set_Date month 0 day 0 year 0000 End_Date
	End_Head

	Section church_date
		Insert_section CONS.DateSetting__.CHURCH_NAME End-Insert
	End-Section
	
	Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
	Section Instance_s05
		Insert_section CONS.Service_Title__.Matins End-Insert
		Insert_section CONS.MA_01_Beginning__.mode_of_celeb_saint End-Insert
		Insert_section CONS.AP.celeb_saint End-Insert
		Insert_section AP.glory__.client1 End-Insert
		Insert_section AP.both__.consecration End-Insert
		Insert_section MA._02_Kathisma1__.litany End-Insert
		Insert_section CONS.MA_02_Kathisma1__.celeb_saint End-Insert
		Insert_section MA._02_Kathisma1__.gloryboth__.consecration End-Insert
		Insert_section CONS.MA_03_Kathisma2__.celeb_saint End-Insert
		Insert_section MA._03_Kathisma2__.gloryboth__.consecration End-Insert
		Insert_section CONS.MA_05_Kathisma3__.celeb_saint End-Insert
		Insert_section MA._05_Kathisma3__.gloryboth__.consecration End-Insert
		Insert_section CONS.MA_06_07_08_Gospel__.celeb_saint End-Insert
		Insert_section CONS.MA_11_Kontakion__.celeb_saint End-Insert
		Insert_section SY.Synaxarion End-Insert
		Insert_section hKA._1345678 End-Insert
		Insert_section MA._10_Canon__.ode9_intro__.hierarch End-Insert
		Insert_section MA._10_Canon__.magnificat__.modeofkatavasia End-Insert
		Insert_section hKA._9 End-Insert
		Insert_section MA._10_Canon__.litanies__.ode9 End-Insert
		Insert_section CONS.MA_12_Exaposteilarion__.celeb_saint End-Insert
	Insert_section church_date End-Insert
		Insert_section CONS.MA_12_Exaposteilarion__.append__.church_saint_and_consecration End-Insert
	Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
		Insert_section MA._13_Lauds__.hierarchical__.mode4 End-Insert
		Insert_section CONS.MA_prayers End-Insert
		Insert_section MA._13_Lauds__.stichologia__.sung__.for6_nocollapse End-Insert
	Insert_section church_date End-Insert
		Section lauds_consecration_and_celeb_and_church_saint
			when-date-is
				Jan 10 use:
					Insert_section MA._13_Lauds__.consecration__.p_123as123 End-Insert
					Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
					Insert_section Selector_Consecration.lauds_celeb_saint_as456 End-Insert
				Mar 17 use:
					Insert_section MA._13_Lauds__.consecration__.p_123as123 End-Insert
					Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
					Insert_section Selector_Consecration.lauds_celeb_saint_as456 End-Insert
				Apr 24 use:
					Insert_section MA._13_Lauds__.consecration__.p_123as123 End-Insert
					Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
					Insert_section Selector_Consecration.lauds_celeb_saint_as456 End-Insert
				May 9 use:
					Insert_section MA._13_Lauds__.consecration__.p_123as123 End-Insert
					Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
					Insert_section Selector_Consecration.lauds_celeb_saint_as456 End-Insert
				Aug 10 use:
					Insert_section MA._13_Lauds__.consecration__.p_123as123 End-Insert
					Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
					Insert_section Selector_Consecration.lauds_celeb_saint_as456 End-Insert
				Sep 17 use:
					Insert_section MA._13_Lauds__.consecration__.p_123as123 End-Insert
					Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
					Insert_section Selector_Consecration.lauds_celeb_saint_as456 End-Insert
				otherwise use:
					Insert_section MA._13_Lauds__.consecration__.p_12as12 End-Insert
					Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
					Insert_section Selector_Consecration.lauds_celeb_saint_as345 End-Insert
					Insert_section church_date End-Insert
					Insert_section Selector_Consecration.lauds_church_saint_as678 End-Insert
			end-when
		End-Section
	Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
		Insert_section CONS.MA_13_Lauds__.glory__.celeb_saint End-Insert
		Insert_section MA._13_Lauds__.both__.consecration End-Insert
