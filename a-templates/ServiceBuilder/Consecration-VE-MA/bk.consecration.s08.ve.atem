Template bk.consecration.s08.ve

Status Review

//s08
//When the church is named for a saint
//When the consecration is conducted on a weekday, on the date of a feast of the Mother of God

	import da.*
	import oc.*
	import me.*
	import eo.*
	import tr.*
	import pe.*

	import actors_gr_GR_cog.*
	import dismissals_gr_GR_cog.*
	import miscellanea_gr_GR_cog.*
	import prayers_gr_GR_cog.*
	import rubrical_gr_GR_cog.*
	import titles_gr_GR_cog.*

	import iTags.*
	import bTags.*
	import roles.*

	Head
		//The full date of the consecration needs to be set here
		Set_Date month 0 day 0 year 0000 End_Date
	End_Head

	Section church_date
		//Ctrl+spacebar right after CHURCH_NAME to select the name of the church being consecrated
		Insert_section CONS.DateSetting__.CHURCH_NAME End-Insert
	End-Section
	
	Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
	Section Instance_s08
		Insert_section CONS.Service_Title__.Vespers End-Insert
		Insert_section VE._01_Beginning__.hierarchical__.vespers End-Insert
		Insert_section CONS.VE_02_LordIHaveCried_SelectedMode__.for10 End-Insert
		Insert_section CONS.VE_03_Stichera__.feast__.as_1234 End-Insert
		Insert_section CONS.VE_03_Stichera__.consecration__.i_123as567 End-Insert
	Insert_section bk.consecration.s08.ve.church_date End-Insert
		Insert_section CONS.VE_03_Stichera__.church_saint__.as_8910 End-Insert
	Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
		Insert_section CONS.VE_03_Stichera__.glory__.feast_of_MotherofGod End-Insert
		Insert_section CONS.VE_03_Stichera__.both__.consecration End-Insert
		Insert_section VE._04_Middle__.hierarchical__.entrance End-Insert
		Insert_section CONS.VE_05_Readings__.feast2consecration1 End-Insert
		Insert_section VE._06_Litanies__.hierarchical__.fullektenia End-Insert
		Insert_section CONS.VE_08_Aposticha__.selected End-Insert
	Insert_section bk.consecration.s08.ve.church_date End-Insert
		Insert_section CONS.VE_08_Aposticha__.glory_and_both__.church_saint_and_feast End-Insert
	Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
		Insert_section VE._09_Symeon_Trisagion__.hierarchical End-Insert
		Insert_section AP.f1 End-Insert
		Insert_section AP.con End-Insert
		Insert_section AP.glory__.client1 End-Insert
		Insert_section AP.both__.feast End-Insert
		Insert_section VE._10_End__.hierarchical__.wisdom123.part1 End-Insert
		Insert_section VE._11_Dismissal__.hierarchical__.nocommemoration End-Insert
	End-Section

End-Template