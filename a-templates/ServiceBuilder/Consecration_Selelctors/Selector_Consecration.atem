	Section Kathisma1_church_saint_and_consecration
		when-movable-cycle-day-is
			127 use: //no kath
				Insert_section MA._02_Kathisma1__.consecration End-Insert
				Insert_section MA._02_Kathisma1__.gloryboth__.consecration End-Insert
			otherwise use:
				when-date-is //for alt1.me
					Feb 6 use: //Photius
						Insert_section TI.ka1.local_church End-Insert
						Title role smallcenter sid client_gr_GR_cog.cl.localchurch.title End-Title
						Insert_section MA._02_Kathisma1__.me__.alt1__.kath11_.hymn End-Insert
						Insert_section MA._02_Kathisma1__.gloryboth__.consecration End-Insert
					Feb 19 use: //Philothea
						Insert_section TI.ka1.local_church End-Insert
