	Section LIHC_hierarchical_modeoffeast //really only needed for feasts of the Lord and the Mother of God
		Para role bkmrk01 sid misc.bookmark End-Para
		Insert_section lihc1_mode End-Insert
		Insert_section lihc1_media_mode End-Insert
		Insert_section VE.LIHC_1 End-Insert
		Insert_section lihc2_media_mode End-Insert
		Insert_section VE.LIHC_2 End-Insert
