	Section stichera_church_feast
		Section as_123
			Insert_section TI.local_church End-Insert
			when-movable-cycle-day-is
				95 use:
					Title role smallcenter sid ti.ForMidpentecost End-Title
					Insert_section VE._03_Stichera__.pe__.p_123as123 End-Insert
				110 use:
					Title role smallcenter sid ti.ForAscension End-Title
					Insert_section VE._03_Stichera__.pe__.i_123as123 End-Insert
				120 use:
				Title role smallcenter sid ti.ForPentecost End-Title
						Insert_section VE._03_Stichera__.pe__.i_123as123 End-Insert
				otherwise use:
					when-date-is
						Jan 6 use:
							Title role smallcenter sid ti.ForEpiphany End-Title
							Insert_section VE._03_Stichera__.me__.i_123as123 End-Insert
						Feb 2 use:
							Title role smallcenter sid ti.ForPresentation End-Title
							Insert_section VE._03_Stichera__.me__.i_123as123 End-Insert
						Mar 25 use:
							Title role smallcenter sid ti.ForAnnunciation End-Title
							Insert_section VE._03_Stichera__.me__.p_123as123 End-Insert
						Aug 6 use:
							Title role smallcenter sid ti.ForTransfiguration End-Title
							Insert_section VE._03_Stichera__.me__.i_123as123 End-Insert
						Aug 15 use:
							Title role smallcenter sid ti.ForDormition End-Title
							Insert_section VE._03_Stichera__.me__.p_123as123 End-Insert
						Sep 8 use:
							Title role smallcenter sid ti.ForTheotokosBirth End-Title
							Insert_section VE._03_Stichera__.me__.i_123as123 End-Insert
						Sep 14 use:
							Title role smallcenter sid ti.ForCross End-Title
							Insert_section VE._03_Stichera__.me__.p_123as123 End-Insert
						Nov 21 use:
							Title role smallcenter sid ti.ForEntry End-Title
							Insert_section VE._03_Stichera__.me__.p_123as123 End-Insert
						Dec 25 use:
							Title role smallcenter sid ti.ForChristmas End-Title
							Insert_section VE._03_Stichera__.me__.i_123as123 End-Insert
					end-when
			end-when
		End-Section
