	Section stichera_church_saint
		Section as_78910
			Insert_section TI.local_church End-Insert
			Title role smallcenter sid client_gr_GR_cog.cl.localchurch.title End-Title
			when-movable-cycle-day-is
				127 use: //All Saints
					Insert_section VE._03_Stichera__.pe__.p_78910as78910 End-Insert
				otherwise use:
					when-date-is //for alt1.me
						Feb 6 use: //Photius
							Insert_section VE._03_Stichera__.me__.alt1__.p_1123as78910 End-Insert
						Feb 19 use: //Philothea
							Insert_section VE._03_Stichera__.me__.alt1__.p_1123as78910 End-Insert
						Jun 12 use: //Gerasimos Abidou
							Insert_section VE._03_Stichera__.me__.alt1__.p_1123as78910 End-Insert
						Jul 22 use: //Markella
							Insert_section VE._03_Stichera__.me__.alt1__.p_1234as78910 End-Insert
						Aug 24 use: //Kosmas Aitolos
							Insert_section VE._03_Stichera__.me__.alt1__.p_1123as78910 End-Insert
						Aug 27 use: //Phanourios
							Insert_section VE._03_Stichera__.me__.alt1__.p_1123as78910 End-Insert
						Oct 20 use: //Gerasimos
							Insert_section VE._03_Stichera__.me__.alt1__.p_1123as78910 End-Insert
						Oct 28 use: //Holy Protection
							Insert_section VE._03_Stichera__.me__.alt1__.p_1123as78910 End-Insert
						Nov 9 use: //Nektarios
							Insert_section VE._03_Stichera__.me__.alt1__.p_1123as78910 End-Insert
						Dec 2 use: //Porphyrios
							Insert_section VE._03_Stichera__.me__.alt1__.p_1123as78910 End-Insert
						Dec 17 use: //Dionysios Aigina
							Insert_section VE._03_Stichera__.me__.alt1__.p_1123as78910 End-Insert
						otherwise use:
							when-date-is //for me irregulars
								Jan 1 use: //Basil
									Insert_section VE._03_Stichera__.me__.p_3345as78910 End-Insert
								May 9 use: //Christopher
									Insert_section VE._03_Stichera__.me__.p_4456as78910 End-Insert
								Jul 26 use: //Paraskevi
									Insert_section VE._03_Stichera__.me__.p_4456as78910 End-Insert
								otherwise use:
									Section menaion
										when-exists
											rid meVE.Stichera01.melody use:
												Section prosomoia
													Insert_section VE._03_Stichera__.me__.p_1123as78910 End-Insert
												End-Section
											otherwise use:
												Section idiomela
													when-exists
														rid meVE.Stichera04.text use:
															Insert_section VE._03_Stichera__.me__.i_1234as78910 End-Insert
														otherwise use:
															Insert_section VE._03_Stichera__.me__.i_1123as78910 End-Insert
													end-when
												End-Section
										end-when
									End-Section
							end-when
					end-when
			end-when
		End-Section
