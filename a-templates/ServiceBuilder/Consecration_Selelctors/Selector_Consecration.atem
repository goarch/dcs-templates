	Section Lauds_hierarchical_modeoffeast //really only needed for feasts of the Lord and the Mother of God
		Para role bkmrk11 sid misc.bookmark End-Para
		Insert_section lauds_mode_of_feast End-Insert
		Insert_section lauds1_media_mode_of_feast End-Insert
		Hymn sid liturgical.verses_gr_GR_cog.psMA.lauds.v1.text @ver media-off End-Hymn
		Insert_section lauds2_media_mode_of_feast End-Insert
		Hymn sid liturgical.verses_gr_GR_cog.psMA.lauds.v2.text @ver media-off End-Hymn
	End-Section
		Section lauds_mode_of_feast //really only needed for feasts of the Lord and the Mother of God
			when-movable-cycle-day-is
				78 use:
					Section ThomasSunday
						Actor sid ac.Chanter End-Actor
						Dialog sid pr.Command_holybishop.text sid pe.d078_gr_GR_cog.peMA.Lauds1.mode End-Dialog
						Actor sid ac.Choir End-Actor
						Title role mode sid pe.d078_gr_GR_cog.peMA.Lauds1.mode End-Title
					End-Section
				95 use:
					Section Midpentecost
						Actor sid ac.Chanter End-Actor
						Dialog sid pr.Command_holybishop.text sid pe.d095_gr_GR_cog.peMA.Lauds1.mode End-Dialog
						Actor sid ac.Choir End-Actor
						Title role mode sid pe.d095_gr_GR_cog.peMA.Lauds1.mode End-Title
					End-Section
				110 use:
					Section Ascension
						Actor sid ac.Chanter End-Actor
						Dialog sid pr.Command_holybishop.text sid pe.d110_gr_GR_cog.peMA.Lauds1.mode End-Dialog
						Actor sid ac.Choir End-Actor
						Title role mode sid pe.d110_gr_GR_cog.peMA.Lauds1.mode End-Title
					End-Section
				120 use:
					Section Pentecost
						Actor sid ac.Chanter End-Actor
						Dialog sid pr.Command_holybishop.text sid pe.d120_gr_GR_cog.peMA.Lauds1.mode End-Dialog
						Actor sid ac.Choir End-Actor
						Title role mode sid pe.d120_gr_GR_cog.peMA.Lauds1.mode End-Title
					End-Section
				otherwise use:
					when-date-is //these can be consolidated into eight modes per month
						Jan 6 use:
							Section Jan06
								Actor sid ac.Chanter End-Actor
								Dialog sid pr.Command_holybishop.text sid me.m01.d06_gr_GR_cog.meMA.Lauds1.mode End-Dialog
								Actor sid ac.Choir End-Actor
								Title role mode sid me.m01.d06_gr_GR_cog.meMA.Lauds1.mode End-Title
							End-Section
