		Section lauds1_media_mode_of_feast
			when-movable-cycle-day-is
				78 use:
					Media rid ocMA.MM.Lauds01.text @mode M1 @day D1 End-Media
				95 use:
					Media rid ocMA.MM.Lauds01.text @mode M4 @day D1 End-Media
				110 use:
					Media rid ocMA.MM.Lauds01.text @mode M6 @day D1 End-Media
				120 use:
					Media rid ocMA.MM.Lauds01.text @mode M1 @day D1 End-Media
				otherwise use:
					when-date-is
						Jan 6 use:
							Media rid ocMA.MM.Lauds01.text @mode M2 @day D1 End-Media
						Feb 2 use:
							Media rid ocMA.MM.Lauds01.text @mode M1 @day D1 End-Media
						Mar 25 use:
							Media rid ocMA.MM.Lauds01.text @mode M6 @day D1 End-Media
						Aug 6 use:
							Media rid ocMA.MM.Lauds01.text @mode M4 @day D1 End-Media
						Aug 15 use:
							Media rid ocMA.MM.Lauds01.text @mode M1 @day D1 End-Media
						Sep 8 use:
							Media rid ocMA.MM.Lauds01.text @mode M6 @day D1 End-Media
						Sep 14 use:
							Media rid ocMA.MM.Lauds01.text @mode M6 @day D1 End-Media
						Nov 21 use:
							Media rid ocMA.MM.Lauds01.text @mode M1 @day D1 End-Media
						Dec 25 use:
							Media rid ocMA.MM.Lauds01.text @mode M2 @day D1 End-Media
					end-when
			end-when
		End-Section
