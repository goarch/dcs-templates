	Section Date__
		Section Reset_to_Default
			Set_Date month 0 day 0 End_Date
			Set_mcDay day 0 End_mcDay
		End-Section
	
		Section Principal_Feast_of_Period
			Set_Date month 0 day 0 End_Date
			Set_mcDay day 0 End_mcDay
			when-movable-cycle-day-is
				95 thru 102 use:
					Section ascension
						Set_mcDay day 95 End_mcDay
					End-Section
				110 thru 118 use:
					Section ascension
						Set_mcDay day 110 End_mcDay
					End-Section
				120 thru 126 use:
					Section pentecost
						Set_mcDay day 120 End_mcDay
					End-Section
				otherwise use:
					when-date-is
						Jan 6 thru 14 use:
							Section epiphany
								Set_Date month 1 day 6 End_Date
							End-Section
						Feb 2 thru 9 use:
							Section presentation
								Set_Date month 2 day 2 End_Date
							End-Section
						Aug 6 thru 13 use:
							Section transfiguration
								Set_Date month 8 day 6 End_Date
							End-Section
						Aug 15 thru 23 use:
							Section dormition
								Set_Date month 8 day 15 End_Date
							End-Section
						Sep 8 thru 12 use:
							Section nativityTheotokos
								Set_Date month 9 day 8 End_Date
							End-Section
						Sep 14 thru 21 use:
							Section cross
								Set_Date month 9 day 14 End_Date
							End-Section
						Nov 21 thru 25 use:
							Section entry
								Set_Date month 11 day 21 End_Date
							End-Section
						Dec 25 thru 31 use:
							Section christmas
								Set_Date month 12 day 25 End_Date
							End-Section
					end-when
			end-when		
		End-Section
	
