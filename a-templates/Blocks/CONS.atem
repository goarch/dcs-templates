					110, 120 use:
						Section idiomela
							when-exists
								rid meVE.Stichera04.text use:
									Insert_section VE._03_Stichera__.me__.i_1234as3456 End-Insert
								otherwise use:
									Insert_section VE._03_Stichera__.me__.i_1123as3456 End-Insert
							end-when
