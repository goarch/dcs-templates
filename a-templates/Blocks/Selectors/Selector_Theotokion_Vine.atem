Template Selector_Theotokion_Vine

	import da.*
	import oc.*
	import me.*
	import eo.*
	import tr.*
	import pe.*

	import actors_gr_GR_cog.*
	import miscellanea_gr_GR_cog.*
	import prayers_gr_GR_cog.*
	import rubrical_gr_GR_cog.*
	import template.titles_gr_GR_cog.*
	import titles_gr_GR_cog.*

	import iTags.*
	import bTags.*
	import roles.*

	Section theotokion
		Title sid ti.BothNow<Tdesig>sid ti.Theotokion</>End-Title
		Para role source0 sid ti.sourceOctoechos End-Para
		Title role mode sid misc.Mode6 End-Title
		when-movable-cycle-day-is
			21 use:
				Insert_section Devouts End-Insert
			28 use:
				Insert_section Martyr End-Insert
			otherwise use:
				when-date-is
					Jan 16 use:
						Insert_section Apostle End-Insert
					Jan 18 use:
						Insert_section Teachers End-Insert
					Jan 27 use:
						Insert_section Hierarch End-Insert
					Feb 17 use:
						Insert_section Martyr End-Insert
					Feb 24 use:
						Insert_section Forerunner End-Insert
					Feb 26 use:
						Insert_section WomanMartyr End-Insert
					Mar 8, 9 use:
						Insert_section Martyrs End-Insert
					Apr 25 use:
						Insert_section Apostle End-Insert
					Jun 4 use:
						Insert_section Hierarch End-Insert
					Jun 19 use:
						Insert_section Apostle End-Insert
					Jun 24 use:
						Insert_section Forerunner End-Insert
					Jun 29, 30 use:
						Insert_section Apostles End-Insert
					Jul 1 use:
						Insert_section Unmercenaries End-Insert
					Jul 5, 12 use:
						Insert_section Devout End-Insert
					Jul 11, 17, 22, 26 use:
						Insert_section WomanMartyr End-Insert
					Jul 20 use:
						Insert_section Prophet End-Insert
					Aug 2 use:
						Insert_section Martyr End-Insert
					Aug 25 use:
						Insert_section Apostles End-Insert
					Aug 26 use:
						Insert_section Martyrs End-Insert
					Aug 29, 30 use:
						Insert_section Forerunner End-Insert
					Sep 23 use:
						Insert_section Forerunner End-Insert
					Sep 28 use:
						Insert_section Devout End-Insert
					Sep 30 use:
						Insert_section Martyr End-Insert
					Oct 6 use:
						Insert_section Apostle End-Insert
					Oct 20 use:
						Insert_section Martyr End-Insert
					Nov 1 use:
						Insert_section Unmercenaries End-Insert
					Nov 3 use:
						Insert_section Martyr End-Insert
					Nov 12 use:
						Insert_section Hierarch End-Insert
					Nov 14, 16 use:
						Insert_section Apostle End-Insert
					Nov 18 use:
						Insert_section Martyr End-Insert
					Dec 2, 5 use:
						Insert_section Devout End-Insert
					Dec 4 use:
						Insert_section WomanMartyr End-Insert
					Dec 15 use:
						Insert_section Martyr End-Insert

				end-when
		end-when
	End-Section
	

	Section Apostle
		Media sid he.o_gr_GR_cog.heOT.TheotokeSyEiApostolou.text End-Media
		Hymn sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text1 sid he.o_gr_GR_cog.heOT.TheotokeSyEiApostolou.text @ver media-off sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text2 End-Hymn
	End-Section

	Section Apostles
		Media sid he.o_gr_GR_cog.heOT.TheotokeSyEiApostolon.text End-Media
		Hymn sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text1 sid he.o_gr_GR_cog.heOT.TheotokeSyEiApostolon.text @ver media-off sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text2 End-Hymn
	End-Section

	Section Devout
		Media sid he.o_gr_GR_cog.heOT.TheotokeSyEiOsiou.text End-Media
		Hymn sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text1 sid he.o_gr_GR_cog.heOT.TheotokeSyEiOsiou.text @ver media-off sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text2 End-Hymn
	End-Section

	Section Devouts
		Media sid he.o_gr_GR_cog.heOT.TheotokeSyEiOsion.text End-Media
		Hymn sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text1 sid he.o_gr_GR_cog.heOT.TheotokeSyEiOsion.text @ver media-off sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text2 End-Hymn
	End-Section

	Section Forerunner
		Media sid he.o_gr_GR_cog.heOT.TheotokeSyEiProdromou.text End-Media
		Hymn sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text1 sid he.o_gr_GR_cog.heOT.TheotokeSyEiProdromou.text @ver media-off sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text2 End-Hymn
	End-Section

	Section Hierarch
		Media sid he.o_gr_GR_cog.heOT.TheotokeSyEiIerarchou.text End-Media
		Hymn sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text1 sid he.o_gr_GR_cog.heOT.TheotokeSyEiIerarchou.text @ver media-off sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text2 End-Hymn
	End-Section

	Section Martyr
		Media sid he.o_gr_GR_cog.heOT.TheotokeSyEiAthloforou.text End-Media
		Hymn sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text1 sid he.o_gr_GR_cog.heOT.TheotokeSyEiAthloforou.text @ver media-off sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text2 End-Hymn
	End-Section

	Section Martyrs
		Media sid he.o_gr_GR_cog.heOT.TheotokeSyEiAthloforon.text End-Media
		Hymn sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text1 sid he.o_gr_GR_cog.heOT.TheotokeSyEiAthloforon.text @ver media-off sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text2 End-Hymn
	End-Section

	Section Prophet
		Media sid he.o_gr_GR_cog.heOT.TheotokeSyEiProfitou.text End-Media
		Hymn sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text1 sid he.o_gr_GR_cog.heOT.TheotokeSyEiProfitou.text @ver media-off sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text2 End-Hymn
	End-Section

	Section Teachers
		Media sid he.o_gr_GR_cog.heOT.TheotokeSyEiDidaskalon.text End-Media
		Hymn sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text1 sid he.o_gr_GR_cog.heOT.TheotokeSyEiDidaskalon.text @ver media-off sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text2 End-Hymn
	End-Section

	Section Unmercenaries
		Media sid he.o_gr_GR_cog.heOT.TheotokeSyEiAnargyron.text End-Media
		Hymn sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text1 sid he.o_gr_GR_cog.heOT.TheotokeSyEiAnargyron.text @ver media-off sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text2 End-Hymn
	End-Section

	Section WomanMartyr
		Media sid he.o_gr_GR_cog.heOT.TheotokeSyEiAthliforou.text End-Media
		Hymn sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text1 sid he.o_gr_GR_cog.heOT.TheotokeSyEiAthliforou.text @ver media-off sid he.o_gr_GR_cog.heOT.TheotokeSyEi.text2 End-Hymn
	End-Section

End-Template