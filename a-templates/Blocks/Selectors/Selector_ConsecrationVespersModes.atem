		Section lihc1_media_mode
			when-movable-cycle-day-is
				110 use:
					Media rid ocVE.MM.LIHC1.text @mode M6 @day D1 End-Media
				120 use:
					Media rid ocVE.MM.LIHC1.text @mode M1 @day D1 End-Media
				otherwise use:
					when-date-is
						Jan 1 use:
							Media rid ocVE.MM.LIHC1.text @mode M8 @day D1 End-Media
						Jan 2 use:
							Media rid ocVE.MM.LIHC1.text @mode M4 @day D1 End-Media
						Jan 3 use:
							Media rid ocVE.MM.LIHC1.text @mode M8 @day D1 End-Media
						Jan 4 use:
							Media rid ocVE.MM.LIHC1.text @mode M4 @day D1 End-Media
						Jan 5 use:
							Media rid ocVE.MM.LIHC1.text @mode M4 @day D1 End-Media
						Jan 6 use:
							Media rid ocVE.MM.LIHC1.text @mode M2 @day D1 End-Media
						Jan 7 use:
							Media rid ocVE.MM.LIHC1.text @mode M2 @day D1 End-Media
						Jan 8 use:
							Media rid ocVE.MM.LIHC1.text @mode M4 @day D1 End-Media
						Jan 9 use:
							Media rid ocVE.MM.LIHC1.text @mode M8 @day D1 End-Media
						Jan 10 use:
