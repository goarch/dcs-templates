	Section sticglory_church_saint_both_consecration
		Insert_section TI.g.local_church End-Insert
		when-movable-cycle-day-is
			127 use:
				Insert_section VE._03_Stichera__.glory__.pe__.gloryasglory_.hymn End-Insert
			otherwise use:
				when-date-is
					Feb 6 use: //Photius
						Insert_section VE._03_Stichera__.glory__.me__.alt1__.gloryasglory_.hymn End-Insert
					Feb 19 use: //Philothea
						Insert_section VE._03_Stichera__.glory__.me__.alt1__.gloryasglory_.hymn End-Insert
					Jun 12 use: //Gerasimos Abidou
						Insert_section VE._03_Stichera__.glory__.me__.alt1__.gloryasglory_.hymn End-Insert
					Aug 24 use: //Kosmas Aitolos
						Insert_section VE._03_Stichera__.glory__.me__.alt1__.gloryasglory_.hymn End-Insert
					Aug 27 use: //Phanourios
						Insert_section VE._03_Stichera__.glory__.me__.alt1__.gloryasglory_.hymn End-Insert
					Oct 20 use: //Gerasimos
						Insert_section VE._03_Stichera__.glory__.me__.alt1__.eightmodedoxasticonasglory_.hymn End-Insert
					Oct 28 use: //Holy Protection
						Insert_section VE._03_Stichera__.glory__.me__.alt1__.gloryasglory_.hymn End-Insert
					Nov 9 use: //Nektarios
						Insert_section VE._03_Stichera__.glory__.me__.alt1__.gloryasglory_.hymn End-Insert
					Dec 2 use: //Porphyrios
						Insert_section VE._03_Stichera__.glory__.me__.alt1__.gloryasglory_.hymn End-Insert
					Dec 17 use: //Dionysios Aigina
						Insert_section VE._03_Stichera__.glory__.me__.alt1__.gloryasglory_.hymn End-Insert
					otherwise use:
						when-exists
							rid meVE.SticGlory.text use:
								Section menaion_yes
									Insert_section VE._03_Stichera__.glory__.me__.gloryasglory_.hymn End-Insert
									Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
									when-name-of-day-is
										Sunday use:
											Insert_section VE._03_Stichera__.both__.firsttheotokion__.modeofweek End-Insert
										otherwise use:
											Insert_section CONS.VE_03_Stichera__.both__.consecration_with_clientname_ End-Insert
									end-when
								End-Section
							otherwise use:
								Insert_section CONS.DateSetting__.Reset_to_Default End-Insert
								when-name-of-day-is
									Sunday use:
										Insert_section CONS.VE_03_Stichera__.both__.consecration_with_clientname_ End-Insert
										Insert_section VE._03_Stichera__.both__.firsttheotokion__.modeofweek End-Insert
									otherwise use:
										Insert_section CONS.VE_03_Stichera__.gloryboth__.consecration_with_clientname_ End-Insert
								end-when
						end-when
				end-when
		end-when
	End-Section

	Section aposglory_church_saint_both_consecration
