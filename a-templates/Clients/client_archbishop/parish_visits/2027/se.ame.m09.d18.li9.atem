Template se.ame.m09.d18.li9

Status NA

	import da.*
	import oc.*
	import me.*
	import eo.*
	import tr.*
	import pe.*

	import actors_gr_GR_cog.*
	import dismissals_gr_GR_cog.*
	import miscellanea_gr_GR_cog.*
	import prayers_gr_GR_cog.*
	import rubrical_gr_GR_cog.*
	import template.titles_gr_GR_cog.*
	import titles_gr_GR_cog.*

	import iTags.*
	import bTags.*
	import roles.*

	Head
		Set_Date month 9 day 18 year 2027 End_Date
			Page_Header_Even
				center @text "Consecration Liturgy on Saturday, September 18, 2027"
			End_Page_Header_Even
			Page_Header_Odd
				center @text "Consecration Liturgy on Saturday, September 18, 2027"
			End_Page_Header_Odd
			Page_Footer_Even
				left @pageNbr
				right @lookup sid pdf.covers_en_US_goarch.footer.attribution.text lang L2
			End_Page_Footer_Even
			Page_Footer_Odd
				left @lookup sid pdf.covers_en_US_goarch.footer.attribution.text lang L2
				right @pageNbr
			End_Page_Footer_Odd
		Set_Page_Number 1 End_Set_Page_Number
	End_Head

	Preface Covers
		Insert_template pdf.cover.li.override End-Insert
		Insert_template pdf.cover.credits End-Insert
	End-Preface

	Section Instance01
		Insert_section HIRgoa.CONS_LI__.AME_.block1 End-Insert
		Insert_section CONS.LI_Epistle End-Insert
		Insert_section CONS.LI_Gospel End-Insert
		Insert_section HIRgoa.CONS_LI__.AME_.block2a End-Insert
		Insert_section HIRgoa.CONS_LI__.AME_.commemoration_concelebrarting_Metropolitan End-Insert
		Insert_section HIRgoa.CONS_LI__.AME_.block2b End-Insert
		Insert_section CONS.LI_26_CommunionHymn_ End-Insert
		Insert_section HIRgoa.CONS_LI__.AME_.block3 End-Insert
	End-Section

End-Template