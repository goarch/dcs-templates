Template bk.festaldates 

	import da.*
	import oc.*
	import me.*
	import eo.*
	import tr.*
	import pe.*

	import actors_gr_GR_cog.*
	import dismissals_gr_GR_cog.*
	import miscellanea_gr_GR_cog.*
	import prayers_gr_GR_cog.*
	import rubrical_gr_GR_cog.*
	import template.titles_gr_GR_cog.*
	import titles_gr_GR_cog.*

	import iTags.*
	import bTags.*
	import roles.*

	Head
		//The date of the service needs to be set here
		//The year of service needs to be set at each Set_Date
		Set_Date month 9 day 18 year 2027 End_Date
	End_Head

	Section date
		Para ldp @Service_Date End-Para
		Insert_section CONS.DATE__.Church_Name_Commemoration.Chrysostom End-Insert
		Para ldp @Service_Date End-Para
		Insert_section CONS.DATE__.Principal_Feast_of_Period End-Insert
		Para ldp @Service_Date End-Para
		Insert_section CONS.DATE__.Reset_to_Default End-Insert
		Para ldp @Service_Date End-Para
		Insert_section CONS.DATE__.Principal_Feast_of_Period End-Insert
		Para ldp @Service_Date End-Para
		Insert_section CONS.DATE__.Church_Name_Commemoration.Chrysostom End-Insert
		Para ldp @Service_Date End-Para
	End-Section


End-Template